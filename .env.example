# ==============================================================================
# Lumina — Telegram School OS Environment Configuration Template
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (dev: sqlite, prod: postgresql)
DATABASE_URL=sqlite+aiosqlite:///./lumina.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lumina

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# WebApp URL
WEBAPP_URL=http://localhost:8000/app

# JWT Security
JWT_SECRET_KEY=your_random_secret_key_here
JWT_EXPIRATION_MINUTES=10080
