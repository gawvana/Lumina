{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org telegram:;"
        }
      ]
    }
  ],
  "services": {
    "lumina-frontend": {
      "root": "webapp"
    },
    "lumina-backend": {
      "root": ".",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "lumina-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "lumina-frontend"
      }
    }
  ]
}
